# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults

# Serving profile:
#   256k     = default, validated: 262144 ctx, 6 concurrent seqs,
#              gpu_memory_utilization 0.72
#   1m-yarn  = experimental: 1M ctx via YaRN, 2 seqs, util 0.82
#PROFILE=256k

# Override the profile's GPU/unified-memory fraction (0..1). Lower it to
# leave more RAM free for the OS/apps. Unset = profile default
# (0.72 for 256k: ~92 GB KV budget on 128 GB).
#GPU_MEMORY_UTILIZATION=0.72

# Host publish port (container always listens on 18081 internally).
#PORT=8080

# Where the 77 GB checkpoint lives / gets downloaded to.
#MODEL_DIR=./models

# vLLM/Triton/HF-modules caches (persists autotune across restarts).
#CACHE_DIR=./.cache

# Image tag and container name.
#IMAGE=ling3-ciru-strix:latest
#CONTAINER_NAME=ling3-ciru-strix

# Optional: HuggingFace token for higher download rate limits.
# `hf` picks it up from env automatically; start.sh passes it through.
#HF_TOKEN=
